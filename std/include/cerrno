// <cerrno>: errno and the Linux error numbers.
#ifndef KARC_STD_CERRNO
#define KARC_STD_CERRNO

// errno is the std's own: libc's lives outside the memory a VM program can
// reach, so both engines use this one and std functions set it.
int* karc_errno_location();
#define errno (*karc_errno_location())

