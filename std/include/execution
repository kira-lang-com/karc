// <execution>: the execution policies and the algorithm overloads that
// take one. KArc runs every policy sequentially, which each policy allows.
#ifndef KARC_STD_EXECUTION
#define KARC_STD_EXECUTION

#include <algorithm>
#include <numeric>
#include <type_traits>

namespace std {

namespace execution {

// One class for all four policies, so one overload per algorithm serves
// each of them.
class karc_policy {
public:
    int kind;
};
typedef karc_policy sequenced_policy;
typedef karc_policy parallel_policy;
typedef karc_policy parallel_unsequenced_policy;
typedef karc_policy unsequenced_policy;
static const karc_policy seq = {0};
static const karc_policy par = {1};
static const karc_policy par_unseq = {2};
static const karc_policy unseq = {3};

}

template <typename T>
struct is_execution_policy { static const bool value = false; };
template <>
struct is_execution_policy<execution::karc_policy> { static const bool value = true; };
template <typename T> inline constexpr bool is_execution_policy_v = is_execution_policy<T>::value;

template <typename I, typename P>
bool all_of(const execution::karc_policy& policy, I first, I last, P predicate) { return all_of(first, last, predicate); }
