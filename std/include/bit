// <bit>: bit counting and rotation over unsigned integers, bit_cast and
// the byte order.
#ifndef KARC_STD_BIT
#define KARC_STD_BIT

#include <cstring>

namespace std {

enum class endian { little = 0, big = 1, native = 0 };

template <typename T>
int popcount(T value) {
    int count = 0;
    unsigned long bits = (unsigned long)value;
    while (bits != 0) {
        count += (int)(bits & 1);
        bits = bits >> 1;
    }
    return count;
}
template <typename T>
int countl_zero(T value) {
    int width = (int)sizeof(T) * 8;
    unsigned long bits = (unsigned long)value;
    int count = 0;
    for (int i = width - 1; i >= 0; i--) {
        if ((bits >> i) & 1) { return count; }
        count++;
    }
    return count;
}
template <typename T>
int countr_zero(T value) {
    int width = (int)sizeof(T) * 8;
    unsigned long bits = (unsigned long)value;
    for (int i = 0; i < width; i++) {
        if ((bits >> i) & 1) { return i; }
    }
    return width;
}
template <typename T>
int countl_one(T value) { return countl_zero((T)~value); }
template <typename T>
int countr_one(T value) { return countr_zero((T)~value); }
template <typename T>
bool has_single_bit(T value) { return value != 0 && (value & (value - 1)) == 0; }
template <typename T>
int bit_width(T value) { return (int)sizeof(T) * 8 - countl_zero(value); }
template <typename T>
T bit_floor(T value) {
    if (value == 0) { return 0; }
    return (T)((T)1 << (bit_width(value) - 1));
}
template <typename T>
T bit_ceil(T value) {
    if (value <= 1) { return 1; }
    return (T)((T)1 << bit_width((T)(value - 1)));
}
template <typename T>
T rotl(T value, int shift) {
    int width = (int)sizeof(T) * 8;
    shift = ((shift % width) + width) % width;
    if (shift == 0) { return value; }
    return (T)((value << shift) | (value >> (width - shift)));
}
template <typename T>
T rotr(T value, int shift) { return rotl(value, 0 - shift); }
template <typename To, typename From>
To bit_cast(const From& value) {
    To result;
    memcpy(&result, &value, sizeof(To));
    return result;
}
template <typename T>
T byteswap(T value) {
    T result;
    const unsigned char* in = (const unsigned char*)&value;
    unsigned char* out = (unsigned char*)&result;
    for (size_t i = 0; i < sizeof(T); i++) { out[i] = in[sizeof(T) - 1 - i]; }
    return result;
}

}

#endif
