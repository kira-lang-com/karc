template <typename T, typename C, typename A>
struct formatter<set<T, C, A>> {
    const char* parse(format_parse_context& context) { return context.begin(); }
    back_insert_iterator<string> format(const set<T, C, A>& value, format_context& context) const {
        return karc_format_write(karc_format_sequence(value.begin(), value.end(), "{", "}"), context);
    }
    int unused;
};
template <typename K, typename V, typename C, typename A>
struct formatter<map<K, V, C, A>> {
    const char* parse(format_parse_context& context) { return context.begin(); }
    back_insert_iterator<string> format(const map<K, V, C, A>& value, format_context& context) const {
        return karc_format_write(karc_format_mapping(value.begin(), value.end()), context);
    }
    int unused;
};
template <typename A, typename B>
struct formatter<pair<A, B>> {
    const char* parse(format_parse_context& context) { return context.begin(); }
    back_insert_iterator<string> format(const pair<A, B>& value, format_context& context) const {
        string text = string("(") + karc_format_element(value.first) + ", " + karc_format_element(value.second) + ")";
        return karc_format_write(text, context);
    }
    int unused;
};

}

#endif
