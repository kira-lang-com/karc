// <typeinfo>: std::type_info, what typeid gives, and the exceptions of
// dynamic_cast and typeid. A type_info holds the chain of names the type
// can be seen as, `;T;Base;...;`; its name is the first.
#ifndef KARC_STD_TYPEINFO
#define KARC_STD_TYPEINFO

#include <exception>

#include <cstring>

namespace std {

class type_info {
public:
    const char* chain_;
    const char* name() const {
        type_info* self = (type_info*)this;
        size_t length = 0;
        const char* start = chain_ + 1;
        while (start[length] != 0 && start[length] != ';' && length < 127) { length++; }
        memcpy(self->name_, start, length);
        self->name_[length] = 0;
        return name_;
    }
    bool operator==(const type_info& other) const { return strcmp(name(), other.name()) == 0; }
    bool operator!=(const type_info& other) const { return !(*this == other); }
    bool before(const type_info& other) const { return strcmp(name(), other.name()) < 0; }
    size_t hash_code() const {
        size_t hash = 14695981039346656037ul;
        for (const char* at = name(); *at != 0; at++) { hash = (hash ^ (unsigned char)*at) * 1099511628211ul; }
        return hash;
    }

private:
    char name_[128];
};

class bad_cast : public exception {
public:
    const char* what() const override { return "std::bad_cast"; }
};
class bad_typeid : public exception {
public:
    const char* what() const override { return "std::bad_typeid"; }
};

}

#endif
