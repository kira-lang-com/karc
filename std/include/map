    }

    karc_tree_iterator<pair<K, V>> insert(const pair<K, V>& value) { return tree_.insertMulti(value); }
    karc_tree_iterator<pair<K, V>> insert(karc_tree_iterator<pair<K, V>> hint, const pair<K, V>& value) { return tree_.insertMulti(value); }
    template <typename I>
    void insert(I first, I last) {
        for (; first != last; ++first) { tree_.insertMulti(*first); }
    }
    void insert(initializer_list<pair<K, V>> items) {
        for (const pair<K, V>* item = items.begin(); item != items.end(); item++) { tree_.insertMulti(*item); }
    }
    template <typename... Args>
    karc_tree_iterator<pair<K, V>> emplace(Args&&... args) { return tree_.insertMulti(pair<K, V>(std::forward<Args>(args)...)); }
    template <typename... Args>
    karc_tree_iterator<pair<K, V>> emplace_hint(karc_tree_iterator<pair<K, V>> hint, Args&&... args) { return tree_.insertMulti(pair<K, V>(std::forward<Args>(args)...)); }
    karc_tree_iterator<pair<K, V>> erase(karc_tree_iterator<pair<K, V>> position) { return tree_.erase(position); }
    karc_tree_iterator<pair<K, V>> erase(karc_tree_iterator<pair<K, V>> first, karc_tree_iterator<pair<K, V>> last) {
        while (first != last) { first = tree_.erase(first); }
        return last;
    }
    size_t erase(const K& key) { return tree_.eraseKey(key); }
    void merge(multimap& other) {
        for (karc_tree_iterator<pair<K, V>> at = other.begin(); at != other.end(); ++at) { tree_.insertMulti(*at); }
        other.clear();
    }

    bool operator==(const multimap& other) const {
        if (size() != other.size()) { return false; }
        karc_tree_iterator<pair<K, V>> mine = begin();
