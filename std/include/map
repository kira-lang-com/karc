    multimap() {}
    explicit multimap(const C& less) : tree_(less) {}
    explicit multimap(const A& alloc) : tree_(C(), alloc) {}
    multimap(const C& less, const A& alloc) : tree_(less, alloc) {}
    A get_allocator() const { return tree_.get_allocator(); }
    multimap(initializer_list<pair<K, V>> items) {
        for (const pair<K, V>* item = items.begin(); item != items.end(); item++) { tree_.insertMulti(*item); }
    }
