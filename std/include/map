// <map>: std::map and std::multimap over an AVL tree (<__tree>).
// Elements are pair<K, V>; iteration is in key order.
#ifndef KARC_STD_MAP
#define KARC_STD_MAP

#include <exception>
#include <__tree>

namespace std {

template <typename K, typename V, typename C = less<K>, typename A = allocator<pair<K, V>>>
class map {
public:
    typedef A allocator_type;
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<K, V> value_type;
    typedef C key_compare;
    typedef size_t size_type;
    typedef karc_tree_iterator<pair<K, V>> iterator;
    typedef karc_tree_iterator<pair<K, V>> const_iterator;

    map() {}
    explicit map(const C& less) : tree_(less) {}
    explicit map(const A& alloc) : tree_(C(), alloc) {}
    map(const C& less, const A& alloc) : tree_(less, alloc) {}
    A get_allocator() const { return tree_.get_allocator(); }
    map(initializer_list<pair<K, V>> items) {
        for (const pair<K, V>* item = items.begin(); item != items.end(); item++) { tree_.insertUnique(*item); }
    }
    template <typename I>
    map(I first, I last) {
        for (; first != last; ++first) { tree_.insertUnique(*first); }
    }

    size_t size() const { return tree_.size(); }
    bool empty() const { return tree_.empty(); }
    size_t max_size() const { return 1152921504606846975ul; }
    void clear() { tree_.clear(); }
    void swap(map& other) { tree_.swap(other.tree_); }
    C key_comp() const { return tree_.key_comp(); }
    karc_tree_iterator<pair<K, V>> begin() const { return tree_.begin(); }
    karc_tree_iterator<pair<K, V>> end() const { return tree_.end(); }
    karc_tree_iterator<pair<K, V>> cbegin() const { return tree_.begin(); }
    karc_tree_iterator<pair<K, V>> cend() const { return tree_.end(); }
    reverse_iterator<karc_tree_iterator<pair<K, V>>> rbegin() const { return reverse_iterator<karc_tree_iterator<pair<K, V>>>(tree_.end()); }
    reverse_iterator<karc_tree_iterator<pair<K, V>>> rend() const { return reverse_iterator<karc_tree_iterator<pair<K, V>>>(tree_.begin()); }

    karc_tree_iterator<pair<K, V>> find(const K& key) const { return tree_.find(key); }
    size_t count(const K& key) const { return tree_.count(key); }
    bool contains(const K& key) const { return tree_.find(key) != tree_.end(); }
    karc_tree_iterator<pair<K, V>> lower_bound(const K& key) const { return tree_.lower_bound(key); }
    karc_tree_iterator<pair<K, V>> upper_bound(const K& key) const { return tree_.upper_bound(key); }
    pair<karc_tree_iterator<pair<K, V>>, karc_tree_iterator<pair<K, V>>> equal_range(const K& key) const {
        return pair<karc_tree_iterator<pair<K, V>>, karc_tree_iterator<pair<K, V>>>(tree_.lower_bound(key), tree_.upper_bound(key));
    }

    pair<karc_tree_iterator<pair<K, V>>, bool> insert(const pair<K, V>& value) { return tree_.insertUnique(value); }
    karc_tree_iterator<pair<K, V>> insert(karc_tree_iterator<pair<K, V>> hint, const pair<K, V>& value) { return tree_.insertUnique(value).first; }
    template <typename I>
    void insert(I first, I last) {
        for (; first != last; ++first) { tree_.insertUnique(*first); }
    }
    void insert(initializer_list<pair<K, V>> items) {
        for (const pair<K, V>* item = items.begin(); item != items.end(); item++) { tree_.insertUnique(*item); }
    }
    template <typename... Args>
    pair<karc_tree_iterator<pair<K, V>>, bool> emplace(Args&&... args) { return tree_.insertUnique(pair<K, V>(std::forward<Args>(args)...)); }
    template <typename... Args>
    karc_tree_iterator<pair<K, V>> emplace_hint(karc_tree_iterator<pair<K, V>> hint, Args&&... args) { return tree_.insertUnique(pair<K, V>(std::forward<Args>(args)...)).first; }
    karc_tree_iterator<pair<K, V>> erase(karc_tree_iterator<pair<K, V>> position) { return tree_.erase(position); }
    karc_tree_iterator<pair<K, V>> erase(karc_tree_iterator<pair<K, V>> first, karc_tree_iterator<pair<K, V>> last) {
        while (first != last) { first = tree_.erase(first); }
        return last;
    }
    size_t erase(const K& key) { return tree_.eraseKey(key); }
    void merge(map& other) {
        for (karc_tree_iterator<pair<K, V>> at = other.begin(); at != other.end(); ++at) { tree_.insertUnique(*at); }
        other.clear();
    }

    V& operator[](const K& key) {
        karc_tree_iterator<pair<K, V>> found = tree_.find(key);
        if (found == tree_.end()) { found = tree_.insertUnique(pair<K, V>(key, V())).first; }
        return found->second;
    }
    V& at(const K& key) const {
        karc_tree_iterator<pair<K, V>> found = tree_.find(key);
        if (found == tree_.end()) { karc_throw_out_of_range("map::at"); }
        return found->second;
    }
    template <typename... Args>
    pair<karc_tree_iterator<pair<K, V>>, bool> try_emplace(const K& key, Args&&... args) {
        karc_tree_iterator<pair<K, V>> found = tree_.find(key);
        if (found != tree_.end()) { return pair<karc_tree_iterator<pair<K, V>>, bool>(found, false); }
        return tree_.insertUnique(pair<K, V>(key, V(std::forward<Args>(args)...)));
    }
    template <typename M>
    pair<karc_tree_iterator<pair<K, V>>, bool> insert_or_assign(const K& key, const M& value) {
        karc_tree_iterator<pair<K, V>> found = tree_.find(key);
        if (found == tree_.end()) { return tree_.insertUnique(pair<K, V>(key, value)); }
        found->second = value;
        return pair<karc_tree_iterator<pair<K, V>>, bool>(found, false);
    }

    bool operator==(const map& other) const {
        if (size() != other.size()) { return false; }
        karc_tree_iterator<pair<K, V>> mine = begin();
        for (karc_tree_iterator<pair<K, V>> theirs = other.begin(); theirs != other.end(); ++theirs) {
            if (!(*mine == *theirs)) { return false; }
            ++mine;
        }
        return true;
    }
    bool operator!=(const map& other) const { return !(*this == other); }
    bool operator<(const map& other) const {
        karc_tree_iterator<pair<K, V>> mine = begin();
        karc_tree_iterator<pair<K, V>> theirs = other.begin();
        while (mine != end() && theirs != other.end()) {
            if (*mine < *theirs) { return true; }
            if (*theirs < *mine) { return false; }
            ++mine;
            ++theirs;
        }
        return mine == end() && theirs != other.end();
    }

private:
    karc_tree<K, pair<K, V>, karc_map_key<K, V>, C, A> tree_;
};

