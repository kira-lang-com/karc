// <debugging>: std::breakpoint and std::is_debugger_present. The debugger
// check reads the TracerPid line of /proc/self/status where there is one.
#ifndef KARC_STD_DEBUGGING
#define KARC_STD_DEBUGGING

#include <csignal>
#include <cstdio>
#include <cstring>

namespace std {

inline bool is_debugger_present() noexcept {
    FILE* status = fopen("/proc/self/status", "r");
    if (status == nullptr) { return false; }
    char line[256];
    bool present = false;
    while (fgets(line, sizeof(line), status) != nullptr) {
        if (strncmp(line, "TracerPid:", 10) == 0) {
            const char* digit = line + 10;
            while (*digit == ' ' || *digit == '\t') { digit++; }
            present = *digit != '0';
        }
    }
    fclose(status);
    return present;
}
inline void breakpoint() noexcept { raise(SIGTRAP); }
inline void breakpoint_if_debugging() noexcept {
    if (is_debugger_present()) { breakpoint(); }
}

}

#endif
