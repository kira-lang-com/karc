// <cmath>. sqrt, fabs, floor, ceil, trunc and round are KIR float operations;
// the rest are computed here from them with range reduction and series.
// `float` is `double` in KArc, so each function has one overload.
#ifndef KARC_STD_CMATH
#define KARC_STD_CMATH

#include <__builtins>

#define M_PI 3.14159265358979323846
#define M_E 2.71828182845904523536
#define M_LN2 0.69314718055994530942
#define HUGE_VAL (1.0 / 0.0)
#define INFINITY (1.0 / 0.0)
#define NAN (0.0 / 0.0)

inline double sqrt(double x) { return __builtin_sqrt(x); }
inline double fabs(double x) { return __builtin_fabs(x); }
inline double floor(double x) { return __builtin_floor(x); }
inline double ceil(double x) { return __builtin_ceil(x); }
inline double trunc(double x) { return __builtin_trunc(x); }
inline double round(double x) {
    if (x < 0.0) { return 0.0 - floor(0.5 - x); }
    return floor(x + 0.5);
}
// Classified from the IEEE 754 bits: an all-ones exponent is infinite with a
// zero mantissa and NaN otherwise.
inline unsigned long doubleBits(double x) { return *(unsigned long*)&x; }
inline bool isnan(double x) {
    unsigned long bits = doubleBits(x);
    return (bits & 9218868437227405312ul) == 9218868437227405312ul && (bits & 4503599627370495ul) != 0;
}
inline bool isinf(double x) {
    unsigned long bits = doubleBits(x);
    return (bits & 9223372036854775807ul) == 9218868437227405312ul;
}
inline bool isfinite(double x) { return (doubleBits(x) & 9218868437227405312ul) != 9218868437227405312ul; }
inline double fmod(double x, double y) { return x - y * trunc(x / y); }
inline double fmin(double a, double b) { if (a < b) { return a; } return b; }
inline double fmax(double a, double b) { if (a > b) { return a; } return b; }
inline double hypot(double a, double b) { return sqrt(a * a + b * b); }
inline double copysign(double magnitude, double sign) {
    double value = fabs(magnitude);
    if (sign < 0.0) { return 0.0 - value; }
    return value;
}

// e^x: x = k ln 2 + r with |r| <= ln 2 / 2, e^r by its series, times 2^k.
inline double exp(double x) {
    if (isnan(x)) { return x; }
    if (x > 709.0) { return HUGE_VAL; }
    if (x < -745.0) { return 0.0; }
    double k = round(x / M_LN2);
    double r = x - k * M_LN2;
    double term = 1.0;
    double sum = 1.0;
    for (int i = 1; i < 30; i++) {
        term = term * r / i;
        sum = sum + term;
    }
    long n = (long)k;
    while (n > 0) { sum = sum * 2.0; n--; }
    while (n < 0) { sum = sum / 2.0; n++; }
    return sum;
}

// ln x: x = m 2^k with m in [1, 2), ln m = 2 atanh((m - 1) / (m + 1)).
inline double log(double x) {
    if (isnan(x) || x < 0.0) { return NAN; }
    if (x == 0.0) { return 0.0 - HUGE_VAL; }
    if (isinf(x)) { return x; }
    double m = x;
    long k = 0;
    while (m >= 2.0) { m = m / 2.0; k++; }
    while (m < 1.0) { m = m * 2.0; k--; }
    double t = (m - 1.0) / (m + 1.0);
    double t2 = t * t;
    double term = t;
    double sum = 0.0;
    for (int i = 1; i < 60; i = i + 2) {
        sum = sum + term / i;
        term = term * t2;
    }
    return 2.0 * sum + k * M_LN2;
}
inline double log10(double x) { return log(x) / 2.30258509299404568402; }
inline double log2(double x) { return log(x) / M_LN2; }

inline double pow(double base, double exponent) {
    if (exponent == 0.0) { return 1.0; }
    if (exponent == trunc(exponent) && fabs(exponent) < 1048576.0) {
        long n = (long)exponent;
        bool invert = n < 0;
        if (invert) { n = 0 - n; }
        double result = 1.0;
        double factor = base;
        while (n > 0) {
            if (n % 2 == 1) { result = result * factor; }
            factor = factor * factor;
            n = n / 2;
        }
        if (invert) { return 1.0 / result; }
        return result;
    }
    if (base < 0.0) { return NAN; }
    return exp(exponent * log(base));
}
inline double cbrt(double x) {
    if (x < 0.0) { return 0.0 - pow(0.0 - x, 1.0 / 3.0); }
    return pow(x, 1.0 / 3.0);
}

// sin and cos: reduce to [-pi, pi], then the Taylor series.
inline double reduceAngle(double x) {
    double turns = round(x / (2.0 * M_PI));
    return x - turns * 2.0 * M_PI;
}
inline double sin(double x) {
    double r = reduceAngle(x);
    double term = r;
    double sum = r;
    for (int i = 1; i < 20; i++) {
        term = (0.0 - term) * r * r / ((2 * i) * (2 * i + 1));
        sum = sum + term;
    }
    return sum;
}
inline double cos(double x) {
    double r = reduceAngle(x);
    double term = 1.0;
    double sum = 1.0;
    for (int i = 1; i < 20; i++) {
        term = (0.0 - term) * r * r / ((2 * i - 1) * (2 * i));
        sum = sum + term;
    }
    return sum;
}
inline double tan(double x) { return sin(x) / cos(x); }

// atan: fold into [0, 1] with atan(x) = pi/2 - atan(1/x), then halve the
// argument twice so the series converges fast.
inline double atan(double x) {
    if (x < 0.0) { return 0.0 - atan(0.0 - x); }
    if (x > 1.0) { return M_PI / 2.0 - atan(1.0 / x); }
    double y = x / (1.0 + sqrt(1.0 + x * x));
    y = y / (1.0 + sqrt(1.0 + y * y));
    double y2 = y * y;
    double term = y;
    double sum = 0.0;
    for (int i = 1; i < 40; i = i + 2) {
        sum = sum + term / i;
        term = (0.0 - term) * y2;
    }
    return 4.0 * sum;
}
inline double atan2(double y, double x) {
    if (x > 0.0) { return atan(y / x); }
    if (x < 0.0 && y >= 0.0) { return atan(y / x) + M_PI; }
    if (x < 0.0) { return atan(y / x) - M_PI; }
    if (y > 0.0) { return M_PI / 2.0; }
    if (y < 0.0) { return 0.0 - M_PI / 2.0; }
    return 0.0;
}
inline double asin(double x) { return atan2(x, sqrt(1.0 - x * x)); }
inline double acos(double x) { return atan2(sqrt(1.0 - x * x), x); }
inline double sinh(double x) { return (exp(x) - exp(0.0 - x)) / 2.0; }
inline double cosh(double x) { return (exp(x) + exp(0.0 - x)) / 2.0; }
inline double tanh(double x) { return sinh(x) / cosh(x); }

#endif
