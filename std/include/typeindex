// <typeindex>: std::type_index, a type_info usable as a map key.
#ifndef KARC_STD_TYPEINDEX
#define KARC_STD_TYPEINDEX

#include <typeinfo>
#include <string>

namespace std {

class type_index {
public:
    type_index(const type_info& info) : name_(info.name()) {}
    const char* name() const { return name_.c_str(); }
    size_t hash_code() const {
        size_t hash = 14695981039346656037ul;
        for (size_t i = 0; i < name_.size(); i++) { hash = (hash ^ (unsigned char)name_[i]) * 1099511628211ul; }
        return hash;
    }
    bool operator==(const type_index& other) const { return name_ == other.name_; }
    bool operator!=(const type_index& other) const { return !(name_ == other.name_); }
    bool operator<(const type_index& other) const { return name_ < other.name_; }

private:
    string name_;
};

}

#endif
