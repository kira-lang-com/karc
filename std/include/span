// <span>: std::span, a pointer and a count over contiguous elements.
#ifndef KARC_STD_SPAN
#define KARC_STD_SPAN

#include <cstddef>
#include <exception>
#include <iterator>

namespace std {

static const size_t dynamic_extent = -1;

// The extent E is carried in the type only: every span keeps its count.
template <typename T, size_t E = dynamic_extent>
class span {
public:
    typedef T element_type;
    typedef T value_type;
    typedef size_t size_type;
    typedef T* iterator;
    static const size_t extent = E;

    span() : data_(0), size_(0) {}
    span(T* data, size_t size) : data_(data), size_(size) {}
    span(T* first, T* last) : data_(first), size_(last - first) {}
    // Any container with data() and size(): vector, array, string.
    template <typename C>
    span(C& container) : data_(container.data()), size_(container.size()) {}

    T* data() const { return data_; }
    size_t size() const { return size_; }
    size_t size_bytes() const { return size_ * sizeof(T); }
    bool empty() const { return size_ == 0; }
    T& operator[](size_t index) const { return data_[index]; }
    T& front() const { return data_[0]; }
    T& back() const { return data_[size_ - 1]; }
    T* begin() const { return data_; }
    T* end() const { return data_ + size_; }
    reverse_iterator<T*> rbegin() const { return reverse_iterator<T*>(data_ + size_); }
    reverse_iterator<T*> rend() const { return reverse_iterator<T*>(data_); }
    span first(size_t count) const { return span(data_, count); }
    span last(size_t count) const { return span(data_ + size_ - count, count); }
    span subspan(size_t offset, size_t count = dynamic_extent) const {
        if (count == dynamic_extent) { count = size_ - offset; }
        return span(data_ + offset, count);
    }

private:
    T* data_;
    size_t size_;
};

}

#endif
