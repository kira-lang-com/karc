// Part of <memory>: unique_ptr, shared_ptr, weak_ptr and
// enable_shared_from_this. A shared_ptr's owners share a control block,
// which counts the shared and the weak owners and, through a virtual
// dispose, deletes the object the way it was given (its deleter, or
// delete of the pointer's own type).
#ifndef KARC_STD_SMART_PTR
#define KARC_STD_SMART_PTR

#include <cstddef>
#include <utility>

namespace std {

template <typename T>
struct default_delete {
    void operator()(T* pointer) const { delete pointer; }
    int unused;
};

template <typename T, typename D = default_delete<T>>
class unique_ptr {
public:
    unique_ptr() : pointer_(0) {}
    explicit unique_ptr(T* pointer) : pointer_(pointer) {}
    unique_ptr(T* pointer, const D& deleter) : pointer_(pointer), deleter_(deleter) {}
    unique_ptr(const unique_ptr& other) = delete;
    unique_ptr(unique_ptr&& other) : pointer_(other.pointer_), deleter_(other.deleter_) { other.pointer_ = 0; }
    // From a unique_ptr to a derived class.
    template <typename U>
    unique_ptr(unique_ptr<U>&& other) : pointer_(other.release()) {}
    ~unique_ptr() {
        if (pointer_ != 0) { deleter_(pointer_); }
    }
    unique_ptr& operator=(const unique_ptr& other) = delete;
    unique_ptr& operator=(unique_ptr&& other) {
        if (this != &other) { reset(other.release()); }
        return *this;
    }
    explicit operator bool() const { return pointer_ != 0; }
    T* get() const { return pointer_; }
    D& get_deleter() { return deleter_; }
    T* release() {
        T* released = pointer_;
        pointer_ = 0;
        return released;
    }
    void reset(T* pointer) {
        T* old = pointer_;
        pointer_ = pointer;
        if (old != 0 && old != pointer) { deleter_(old); }
    }
    void reset() { reset(0); }
    void swap(unique_ptr& other) {
        T* held = pointer_;
        pointer_ = other.pointer_;
        other.pointer_ = held;
    }
    T& operator*() const { return *pointer_; }
    T* operator->() const { return pointer_; }
    bool operator==(const unique_ptr& other) const { return pointer_ == other.pointer_; }
    bool operator!=(const unique_ptr& other) const { return pointer_ != other.pointer_; }
    bool operator==(nullptr_t null) const { return pointer_ == 0; }
    bool operator!=(nullptr_t null) const { return pointer_ != 0; }

private:
    T* pointer_;
    D deleter_;
};

// An owned array: delete[] and element access.
template <typename T>
struct default_delete<T[]> {
    void operator()(T* pointer) const { delete[] pointer; }
    int unused;
};
template <typename T, typename D>
class unique_ptr<T[], D> {
public:
    unique_ptr() : pointer_(0) {}
    explicit unique_ptr(T* pointer) : pointer_(pointer) {}
    unique_ptr(const unique_ptr& other) = delete;
    unique_ptr(unique_ptr&& other) : pointer_(other.pointer_) { other.pointer_ = 0; }
    ~unique_ptr() {
        if (pointer_ != 0) { delete[] pointer_; }
    }
    unique_ptr& operator=(const unique_ptr& other) = delete;
    unique_ptr& operator=(unique_ptr&& other) {
        if (this != &other) { reset(other.release()); }
        return *this;
    }
    T& operator[](size_t index) const { return pointer_[index]; }
    explicit operator bool() const { return pointer_ != 0; }
    T* get() const { return pointer_; }
    T* release() {
        T* released = pointer_;
        pointer_ = 0;
        return released;
    }
    void reset(T* pointer) {
        T* old = pointer_;
        pointer_ = pointer;
        if (old != 0 && old != pointer) { delete[] old; }
    }
    void reset() { reset(0); }

private:
    T* pointer_;
};

// The shared and weak counts of a shared object; dispose ends the object.
class karc_control {
public:
    karc_control() : strong_(1), weak_(0) {}
    virtual ~karc_control() {}
    virtual void dispose() {}
    long strong_;
    long weak_;
};
template <typename T>
class karc_control_delete : public karc_control {
public:
    karc_control_delete(T* pointer) : pointer_(pointer) {}
    void dispose() override { delete pointer_; }
    T* pointer_;
};
template <typename T, typename D>
class karc_control_deleter : public karc_control {
public:
    karc_control_deleter(T* pointer, const D& deleter) : pointer_(pointer), deleter_(deleter) {}
    void dispose() override { deleter_(pointer_); }
    T* pointer_;
    D deleter_;
};

template <typename T>
class weak_ptr;
template <typename T>
class enable_shared_from_this;

template <typename T>
class shared_ptr {
public:
    typedef T element_type;
    shared_ptr() : pointer_(0), control_(0) {}
    shared_ptr(nullptr_t null) : pointer_(0), control_(0) {}
    explicit shared_ptr(T* pointer) : pointer_(pointer), control_(0) {
        if (pointer_ != 0) {
            control_ = new karc_control_delete<T>(pointer);
            karc_share(pointer);
        }
    }
    template <typename D>
    shared_ptr(T* pointer, D deleter) : pointer_(pointer), control_(new karc_control_deleter<T, D>(pointer, deleter)) {
        karc_share(pointer);
    }
    shared_ptr(const shared_ptr& other) : pointer_(other.pointer_), control_(other.control_) {
        if (control_ != 0) { control_->strong_++; }
    }
    shared_ptr(shared_ptr&& other) : pointer_(other.pointer_), control_(other.control_) {
        other.pointer_ = 0;
        other.control_ = 0;
    }
    // Sharing the ownership of a shared_ptr to a derived class.
    template <typename U>
    shared_ptr(const shared_ptr<U>& other) : pointer_(other.get()), control_(other.karc_block()) {
        if (control_ != 0) { control_->strong_++; }
    }
    // The aliasing constructor: `other`'s ownership, `pointer`'s object.
    template <typename U>
    shared_ptr(const shared_ptr<U>& other, T* pointer) : pointer_(pointer), control_(other.karc_block()) {
        if (control_ != 0) { control_->strong_++; }
    }
    // Another owner of `control`'s object, when it still lives, else empty
    // (weak_ptr::lock and the pointer casts).
    shared_ptr(T* pointer, karc_control* control, bool shared) : pointer_(0), control_(0) {
        if (control != 0 && control->strong_ > 0) {
            pointer_ = pointer;
            control_ = control;
            control_->strong_++;
        }
    }
    ~shared_ptr() { release(); }
    shared_ptr& operator=(const shared_ptr& other) {
        if (control_ != other.control_) {
            if (other.control_ != 0) { other.control_->strong_++; }
            release();
            control_ = other.control_;
        }
        pointer_ = other.pointer_;
        return *this;
    }
    shared_ptr& operator=(shared_ptr&& other) {
        if (this != &other) {
            release();
            pointer_ = other.pointer_;
            control_ = other.control_;
            other.pointer_ = 0;
            other.control_ = 0;
        }
        return *this;
    }
    T* get() const { return pointer_; }
    long use_count() const { return control_ == 0 ? 0 : control_->strong_; }
    bool unique() const { return use_count() == 1; }
    explicit operator bool() const { return pointer_ != 0; }
    void reset() {
        release();
        pointer_ = 0;
    }
    void reset(T* pointer) {
        shared_ptr fresh(pointer);
        swap(fresh);
    }
    void swap(shared_ptr& other) {
        T* pointer = pointer_;
        pointer_ = other.pointer_;
        other.pointer_ = pointer;
        karc_control* control = control_;
        control_ = other.control_;
        other.control_ = control;
    }
    T& operator*() const { return *pointer_; }
    T* operator->() const { return pointer_; }
    bool operator==(const shared_ptr& other) const { return pointer_ == other.pointer_; }
    bool operator!=(const shared_ptr& other) const { return pointer_ != other.pointer_; }
    bool operator<(const shared_ptr& other) const { return pointer_ < other.pointer_; }
    bool operator==(nullptr_t null) const { return pointer_ == 0; }
    bool operator!=(nullptr_t null) const { return pointer_ != 0; }
    bool owner_before(const shared_ptr& other) const { return control_ < other.control_; }
    karc_control* karc_block() const { return control_; }

private:
    void release() {
        if (control_ == 0) { return; }
        control_->strong_--;
        if (control_->strong_ == 0) {
            control_->weak_++;
            control_->dispose();
            control_->weak_--;
            if (control_->weak_ == 0) { delete control_; }
        }
        control_ = 0;
    }
    // A class deriving from enable_shared_from_this learns its owner.
    void karc_share(T* pointer) {
        if (__karc_derives(enable_shared_from_this<T>, T)) {
            ((enable_shared_from_this<T>*)pointer)->karc_adopt(pointer, control_);
        }
    }
    T* pointer_;
    karc_control* control_;
};

template <typename T>
class weak_ptr {
public:
    weak_ptr() : pointer_(0), control_(0) {}
    weak_ptr(const shared_ptr<T>& owner) : pointer_(owner.get()), control_(owner.karc_block()) {
        if (control_ != 0) { control_->weak_++; }
    }
    weak_ptr(const weak_ptr& other) : pointer_(other.pointer_), control_(other.control_) {
        if (control_ != 0) { control_->weak_++; }
    }
    ~weak_ptr() { release(); }
    weak_ptr& operator=(const weak_ptr& other) {
        if (this != &other) {
            if (other.control_ != 0) { other.control_->weak_++; }
            release();
            pointer_ = other.pointer_;
            control_ = other.control_;
        }
        return *this;
    }
    weak_ptr& operator=(const shared_ptr<T>& owner) {
        weak_ptr fresh(owner);
        *this = fresh;
        return *this;
    }
    long use_count() const { return control_ == 0 ? 0 : control_->strong_; }
    bool expired() const { return use_count() == 0; }
    shared_ptr<T> lock() const { return shared_ptr<T>(pointer_, control_, true); }
    void reset() {
        release();
        pointer_ = 0;
    }
    // Pointing at an object `control` shares, without owning it.
    void karc_watch(T* pointer, karc_control* control) {
        release();
        pointer_ = pointer;
        control_ = control;
        if (control_ != 0) { control_->weak_++; }
    }

private:
    void release() {
        if (control_ == 0) { return; }
        control_->weak_--;
        if (control_->weak_ == 0 && control_->strong_ == 0) { delete control_; }
        control_ = 0;
    }
    T* pointer_;
    karc_control* control_;
};

template <typename T>
class enable_shared_from_this {
public:
    shared_ptr<T> shared_from_this() const { return self_.lock(); }
    weak_ptr<T> weak_from_this() const { return self_; }
    void karc_adopt(T* pointer, karc_control* control) { self_.karc_watch(pointer, control); }

private:
    weak_ptr<T> self_;
};

// make_unique<T[]>(n): n value-initialized elements.
template <typename T>
unique_ptr<T> karc_make_unique_array(size_t count) {
    typedef __karc_element(T) E;
    return unique_ptr<T>(new E[count]());
}
template <typename T, typename... Args>
auto make_unique(Args&&... args) {
    if constexpr (is_array_v<T>) {
        return karc_make_unique_array<T>(args...);
    } else {
        return unique_ptr<T>(new T(std::forward<Args>(args)...));
    }
}

template <typename T, typename... Args>
shared_ptr<T> make_shared(Args&&... args) { return shared_ptr<T>(new T(std::forward<Args>(args)...)); }

// The casts share `from`'s ownership through its control block.
template <typename T, typename U>
shared_ptr<T> static_pointer_cast(const shared_ptr<U>& from) { return shared_ptr<T>(static_cast<T*>(from.get()), from.karc_block(), true); }
template <typename T, typename U>
shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& from) {
    T* cast = dynamic_cast<T*>(from.get());
    if (cast == 0) { return shared_ptr<T>(); }
    return shared_ptr<T>(cast, from.karc_block(), true);
}
template <typename T, typename U>
shared_ptr<T> const_pointer_cast(const shared_ptr<U>& from) { return shared_ptr<T>((T*)from.get(), from.karc_block(), true); }

template <typename T>
void swap(shared_ptr<T>& a, shared_ptr<T>& b) { a.swap(b); }

}

#endif
