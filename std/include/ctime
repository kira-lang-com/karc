// <ctime>: time, clock and calendar conversion, over clock_gettime.
#ifndef KARC_STD_CTIME
#define KARC_STD_CTIME

#include <cstddef>
#include <cstdio>

typedef long time_t;
typedef long clock_t;

#define CLOCKS_PER_SEC 1000000
#define CLOCK_REALTIME 0
#define CLOCK_MONOTONIC 1
#define CLOCK_PROCESS_CPUTIME_ID 2

struct timespec {
    long tv_sec;
    long tv_nsec;
};

struct tm {
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
};

extern "C" int clock_gettime(int clock, struct timespec* now);

inline time_t time(time_t* out) {
    struct timespec now;
    clock_gettime(CLOCK_REALTIME, &now);
    if (out != 0) { *out = now.tv_sec; }
    return now.tv_sec;
}

inline clock_t clock() {
    struct timespec now;
    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &now);
    return now.tv_sec * 1000000 + now.tv_nsec / 1000;
}

inline double difftime(time_t end, time_t start) { return (double)(end - start); }

static struct tm karc_calendar_result;

// The civil date of a day count since 1970-01-01 (Howard Hinnant's algorithm).
inline struct tm* gmtime(const time_t* when) {
    struct tm& result = karc_calendar_result;
    long seconds = *when;
    long days = seconds / 86400;
    long rest = seconds % 86400;
    if (rest < 0) {
        rest = rest + 86400;
        days = days - 1;
    }
    result.tm_hour = rest / 3600;
    result.tm_min = rest % 3600 / 60;
    result.tm_sec = rest % 60;
    result.tm_wday = (days + 4) % 7;
    if (result.tm_wday < 0) { result.tm_wday = result.tm_wday + 7; }
    long z = days + 719468;
    long era = z / 146097;
    if (z < 0 && z % 146097 != 0) { era = era - 1; }
    long dayOfEra = z - era * 146097;
    long yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;
    long dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);
    long monthPart = (5 * dayOfYear + 2) / 153;
    long day = dayOfYear - (153 * monthPart + 2) / 5 + 1;
    long month = monthPart + 3;
    if (monthPart >= 10) { month = monthPart - 9; }
    long year = yearOfEra + era * 400;
    if (month <= 2) { year = year + 1; }
    result.tm_mday = day;
    result.tm_mon = month - 1;
    result.tm_year = year - 1900;
    long januaryFirst = 0;
    long cumulative[12];
    cumulative[0] = 0; cumulative[1] = 31; cumulative[2] = 59; cumulative[3] = 90; cumulative[4] = 120; cumulative[5] = 151;
    cumulative[6] = 181; cumulative[7] = 212; cumulative[8] = 243; cumulative[9] = 273; cumulative[10] = 304; cumulative[11] = 334;
    long leap = 0;
    if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) { leap = 1; }
    januaryFirst = cumulative[month - 1] + day - 1;
    if (month > 2) { januaryFirst = januaryFirst + leap; }
    result.tm_yday = januaryFirst;
    result.tm_isdst = 0;
    return &result;
}

// Local time is UTC: KArc does not read the time zone database.
inline struct tm* localtime(const time_t* when) { return gmtime(when); }

inline size_t strftime(char* out, size_t size, const char* format, const struct tm* when) {
    size_t written = 0;
    while (*format != 0 && written + 1 < size) {
        if (*format != '%') {
            out[written] = *format;
            written++;
            format++;
            continue;
        }
        format++;
        char piece[32];
        piece[0] = 0;
        if (*format == 'Y') { snprintf(piece, 32, "%d", when->tm_year + 1900); }
        else if (*format == 'm') { snprintf(piece, 32, "%02d", when->tm_mon + 1); }
        else if (*format == 'd') { snprintf(piece, 32, "%02d", when->tm_mday); }
        else if (*format == 'H') { snprintf(piece, 32, "%02d", when->tm_hour); }
        else if (*format == 'M') { snprintf(piece, 32, "%02d", when->tm_min); }
        else if (*format == 'S') { snprintf(piece, 32, "%02d", when->tm_sec); }
        else if (*format == 'j') { snprintf(piece, 32, "%03d", when->tm_yday + 1); }
        else if (*format == '%') { snprintf(piece, 32, "%%"); }
        for (int i = 0; piece[i] != 0 && written + 1 < size; i++) {
            out[written] = piece[i];
            written++;
        }
        if (*format != 0) { format++; }
    }
    out[written] = 0;
    return written;
}

#endif
