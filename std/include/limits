// <limits>: std::numeric_limits. Without specializations, each member
// works out the answer for T from how T behaves.
#ifndef KARC_STD_LIMITS
#define KARC_STD_LIMITS

namespace std {

template <typename T>
class numeric_limits {
public:
    static bool is_integer() { return (T)0.5 == (T)0; }
    static bool is_signed() { return (T)-1 < (T)0; }
    static T max() {
        if (!is_integer()) { return (T)1.7976931348623157e308; }
        unsigned long all = 0;
        all = ~all;
        unsigned long bits = sizeof(T) * 8;
        if (bits < 64) { all = ((unsigned long)1 << bits) - 1; }
        if (is_signed()) { all = all >> 1; }
        return (T)all;
    }
    static T min() {
        if (!is_integer()) { return (T)2.2250738585072014e-308; }
        if (!is_signed()) { return (T)0; }
        return (T)(0 - (long)max() - 1);
    }
    static T lowest() {
        if (!is_integer()) { return (T)(0.0 - 1.7976931348623157e308); }
        return min();
    }
    static T epsilon() {
        if (!is_integer()) { return (T)2.220446049250313e-16; }
        return (T)0;
    }
    static int digits() {
        if (!is_integer()) { return 53; }
        if (is_signed()) { return sizeof(T) * 8 - 1; }
        return sizeof(T) * 8;
    }
};

}

#endif
