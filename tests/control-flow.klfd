import Testing

@Test
function compilesBreakAndContinue() {
    expect!(run("""
        int main() { int s = 0; for (int i = 0; i < 100; i++) { if (i == 5) { break; } s += i; } return s; }
        """) == 10)
    expect!(run("""
        int main() { int s = 0; for (int i = 0; i < 10; i++) { if (i % 2 == 0) { continue; } s += i; } return s; }
        """) == 25)
    expect!(run("int main() { int i = 0; while (i < 100) { if (i == 7) { break; } i++; } return i; }") == 7)
    expect!(run("""
        int main() { int i = 0; int s = 0; while (i < 5) { i++; if (i == 3) { continue; } s += i; } return s; }
        """) == 12)
    expect!(run("""
        int main() { int c = 0; for (int i = 0; i < 3; i++) { for (int j = 0; j < 3; j++) { if (j == 1) { break; } c++; } } return c; }
        """) == 3)
}

@Test
function compilesForLoops() {
    expect!(run("int main() { int s = 0; for (int i = 0; i < 5; i = i + 1) { s = s + i; } return s; }") == 10)
    expect!(run("int main() { int f = 1; for (int i = 1; i <= 5; i = i + 1) { f = f * i; } return f; }") == 120)
    expect!(run("""
        int main() { int c = 0; for (int i = 0; i < 3; i = i + 1) { for (int j = 0; j < 3; j = j + 1) { c = c + 1; } } return c; }
        """) == 9)
    expect!(run("""
        int main() { int n = 0; int i = 0; for (i = 0; i < 7; i = i + 2) { n = n + 1; } return n; }
        """) == 4)
}

@Test
function compilesIfElseControlFlow() {
    expect!(run("int main() { int x = 5; int r = 0; if (x > 3) { r = 1; } return r; }") == 1)
    expect!(run("int main() { int x = 2; int r = 0; if (x > 3) { r = 1; } else { r = 2; } return r; }") == 2)
    expect!(run("""
        int max(int a, int b) { int m = a; if (b > a) { m = b; } return m; } int main() { return max(3, 9); }
        """) == 9)
    expect!(run("""
        int classify(int n) { int r = 0; if (n < 0) { r = 0; } else if (n == 0) { r = 1; } else { r = 2; } return r; } int main() { return classify(0 - 4); }
        """) == 0)
    expect!(run("""
        int classify(int n) { int r = 0; if (n < 0) { r = 0; } else if (n == 0) { r = 1; } else { r = 2; } return r; } int main() { return classify(0); }
        """) == 1)
    expect!(run("""
        int classify(int n) { int r = 0; if (n < 0) { r = 0; } else if (n == 0) { r = 1; } else { r = 2; } return r; } int main() { return classify(7); }
        """) == 2)
    expect!(run("""
        int main() { int i = 0; int c = 0; while (i < 10) { if (i % 3 == 0) { c = c + 1; } i = i + 1; } return c; }
        """) == 4)
}

@Test
function compilesSwitchStatements() {
    expect!(run("""
        int classify(int n) { int r = 0; switch (n) { case 1: r = 10; break; case 2: r = 20; break; default: r = 99; } return r; } int main() { return classify(1); }
        """) == 10)
    expect!(run("""
        int classify(int n) { int r = 0; switch (n) { case 1: r = 10; break; case 2: r = 20; break; default: r = 99; } return r; } int main() { return classify(2); }
        """) == 20)
    expect!(run("""
        int classify(int n) { int r = 0; switch (n) { case 1: r = 10; break; case 2: r = 20; break; default: r = 99; } return r; } int main() { return classify(7); }
        """) == 99)
    expect!(run("""
        int count(int n) { int r = 0; switch (n) { case 1: r = r + 1; case 2: r = r + 1; case 3: r = r + 1; break; default: r = 100; } return r; } int main() { return count(1); }
        """) == 3)
    expect!(run("""
        int count(int n) { int r = 0; switch (n) { case 1: r = r + 1; case 2: r = r + 1; case 3: r = r + 1; break; default: r = 100; } return r; } int main() { return count(2); }
        """) == 2)
    expect!(run("""
        int count(int n) { int r = 0; switch (n) { case 1: r = r + 1; case 2: r = r + 1; case 3: r = r + 1; break; default: r = 100; } return r; } int main() { return count(3); }
        """) == 1)
    expect!(run("""
        int count(int n) { int r = 0; switch (n) { case 1: r = r + 1; case 2: r = r + 1; case 3: r = r + 1; break; default: r = 100; } return r; } int main() { return count(9); }
        """) == 100)
    expect!(run("""
        int main() { int total = 0; for (int i = 0; i < 5; i++) { switch (i % 2) { case 0: total += 10; break; default: total += 1; } } return total; }
        """) == 32)
}
