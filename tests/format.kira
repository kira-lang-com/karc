import KLF

@Test
function formatsCWithDirectivesAndComments() {
    expect!(formats("#define N 2\nint main(){// hi\nint x=N;return x;}\n",
        "#define N 2\nint main() { // hi\n    int x = N;\n    return x;\n}\n"))
}

@Test
function formatsCxxStatements() {
    expect!(formats("int main(){int x=1+2;return x;}\n",
        "int main() {\n    int x = 1 + 2;\n    return x;\n}\n"))
}

@Test
function formatsUserDefinedLiteralsWithoutLosingTheirSpelling() {
    expect!(formats("long operator\"\"_x(unsigned long x){return x;} int main(){return 1_x;}\n",
        "long operator\"\"_x(unsigned long x) {\n    return x;\n} int main() {\n    return 1_x;\n}\n"))
}

@Test
function preservesSplicedTokens() {
    expect!(formats("int main(){int va\\\nlue=42;return value;}\n",
        "int main() {\n    int va\\\nlue = 42;\n    return value;\n}\n"))
}

@Test
function keepsStringLiteralSuffixAttached() {
    expect!(formats("int main(){\"hi\"_x;return 0;}\n",
        "int main() {\n    \"hi\"_x;\n    return 0;\n}\n"))
}
