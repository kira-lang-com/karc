import Testing

@Test
function compilesAndRunsVariedCpp() {
    expect!(run("int main() { return 2 + 3 * 4; }") == 14)
    expect!(run("int main() { return (2 + 3) * 4; }") == 20)
    expect!(run("int main() { return 100 - 30 - 20; }") == 50)
    expect!(run("int sq(int n) { int r = n * n; return r; } int main() { return sq(7); }") == 49)
    expect!(run("int main() { int s = 0; int i = 0; while (i < 5) { s = s + i; i = i + 1; } return s; }") == 10)
    expect!(run("int add(int a, int b) { return a + b; } int main() { return add(40, 2); }") == 42)
}

@Test
function compilesComparisonAndDivisionOperators() {
    expect!(run("int main() { return 5 > 3; }") == 1)
    expect!(run("int main() { return 3 > 5; }") == 0)
    expect!(run("int main() { return 5 == 5; }") == 1)
    expect!(run("int main() { return 7 != 3; }") == 1)
    expect!(run("int main() { return 10 <= 10; }") == 1)
    expect!(run("int main() { return 4 >= 9; }") == 0)
    expect!(run("int main() { return 20 / 6; }") == 3)
    expect!(run("int main() { return 20 % 6; }") == 2)
    expect!(run("int main() { return 2 + 3 == 5; }") == 1)
    expect!(run("""
        int main() { int i = 0; int c = 0; while (i < 10) { c = c + (i % 2); i = i + 1; } return c; }
        """) == 5)
}

@Test
function compilesLogicalAndOrWithShortCircuit() {
    expect!(run("int main() { int a = 1; int b = 0; int r = 2; if (a && b) { r = 1; } return r; }") == 2)
    expect!(run("int main() { int a = 1; int b = 1; int r = 2; if (a && b) { r = 1; } return r; }") == 1)
    expect!(run("int main() { int a = 0; int b = 1; int r = 2; if (a || b) { r = 1; } return r; }") == 1)
    expect!(run("int main() { int a = 0; int b = 0; int r = 2; if (a || b) { r = 1; } return r; }") == 2)
    expect!(run("int main() { int x = 3; int r = 0; if (x > 0 && x < 10) { r = 1; } return r; }") == 1)
    expect!(run("int main() { return (2 > 1) && (3 > 2); }") == 1)
    expect!(run("""
        int boom() { return 1 / 0; } int main() { int a = 0; int r = 5; if (a && boom()) { r = 1; } return r; }
        """) == 5)
    expect!(run("""
        int boom() { return 1 / 0; } int main() { int a = 1; int r = 0; if (a || boom()) { r = 9; } return r; }
        """) == 9)
}

@Test
function compilesTernaryConditional() {
    expect!(run("int main() { int x = 5; return x > 3 ? 10 : 20; }") == 10)
    expect!(run("int main() { int x = 2; return x > 3 ? 10 : 20; }") == 20)
    expect!(run("int max(int a, int b) { return a > b ? a : b; } int main() { return max(7, 3); }") == 7)
    expect!(run("int main() { int x = 0; return x < 0 ? 1 : (x == 0 ? 2 : 3); }") == 2)
    expect!(run("int main() { int a = 5; return (a > 0 && a < 10) ? a * 2 : 0; }") == 10)
}
