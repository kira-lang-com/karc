// Templates. A template declaration keeps its parameters and the tokens of
// the declaration it introduces. A class template is instantiated while
// parsing: `vector<int>` substitutes the arguments into those tokens and parses
// them as the class `vector__i32`. Function templates are instantiated by the
// lowering, which knows the argument types (lowering/lower_template.klfd).

// After `template`: the parameter list and the declaration it governs.
function parseTemplateDeclaration(p: borrow mut Parser, owner: String) {
    expect(p, .Lt)
    var params: [String] = []
    var valueParams: [Bool] = []
    var defaults: [[Token]] = []
    var pack = -1
    while !closesAngle(p) && peekKind(p) != .End && p.error == "" {
        var isValue = true
        if peekKind(p) == .Ident && (peek(p).text == "typename" || peek(p).text == "class") {
            consume(p)
            isValue = false
        } else {
            parseTypeToken(p)
        }
        if peekKind(p) == .Ellipsis {
            consume(p)
            pack = params.count
        }
        var name = ""
        if peekKind(p) == .Ident { name = consume(p).text }
        var fallback: [Token] = []
        if peekKind(p) == .Assign {
            consume(p)
            var depth = 0
            while peekKind(p) != .End && p.error == "" {
                if depth == 0 && (peekKind(p) == .Comma || closesAngle(p)) { break }
                if depth == 1 && peekKind(p) == .Shr {
                    // `= less<K>>`: the `>>` closes the default and the list.
                    let t = consume(p)
                    fallback.append(Token { space = false, spelling = "", kind = .Gt, text = ">", number = 0, start = t.start, end = t.start + 1, line = t.line })
                    p.pendingGt = true
                    break
                }
                if depth >= 2 && peekKind(p) == .Shr {
                    // `>>` closing two nested arguments of the default.
                    let t = consume(p)
                    fallback.append(Token { space = false, spelling = "", kind = .Gt, text = ">", number = 0, start = t.start, end = t.start + 1, line = t.line })
                    fallback.append(Token { space = false, spelling = "", kind = .Gt, text = ">", number = 0, start = t.start + 1, end = t.end, line = false })
                    depth = depth - 2
                    continue
                }
                if peekKind(p) == .Lt || peekKind(p) == .LParen { depth = depth + 1 }
                if peekKind(p) == .Gt || peekKind(p) == .RParen { depth = depth - 1 }
                fallback.append(consume(p))
            }
        }
        params.append(name)
        valueParams.append(isValue)
        defaults.append(fallback)
        if peekKind(p) == .Comma { consume(p) }
    }
    expectCloseAngle(p)
    let tokens = withoutClassQualifier(captureDeclaration(p))
    if params.count == 0 || tokens.count == 0 { return }
    if specializedClass(tokens) {
        recordSpecialization(p, params, tokens)
        return
    }
    var isClass = false
    var name = ""
    let head = tokens[0]
    if head.kind == .Ident && head.text == "using" && tokens.count > 1 {
        isClass = true
        name = tokens[1].text
    } else if (head.kind == .KwStruct || (head.kind == .Ident && head.text == "class")) && tokens.count > 1 {
        isClass = true
        name = tokens[1].text
        if tokens.count > 2 && tokens[2].kind == .Semicolon { return }
    } else if variableTemplateName(tokens) != "" {
        // `template <...> constexpr T name = value;`
        let variable = variableTemplateName(tokens)
        p.tree.templates.append(CppTemplate { name = declaredName(p, variable), params = params, valueParams = valueParams, defaults = defaults, tokens = tokens, isClass = false, owner = "@variable", pack = pack })
        return
    } else {
        name = templateFunctionName(tokens)
        if name == "" { name = templateOperatorName(tokens) }
    }
    if name == "" { return }
    var qualified = declaredName(p, name)
    if owner != "" && !isClass { qualified = joinText([owner, "::", name]) }
    if isClass { declareEntity(p.tree, qualified, .ClassTemplate) }
    else { declareEntity(p.tree, qualified, .FunctionTemplate) }
    p.tree.templates.append(CppTemplate { name = qualified, params = params, valueParams = valueParams, defaults = defaults, tokens = tokens, isClass = isClass, owner = owner, pack = pack })
}
// The tokens of one declaration: a class through its closing `};`, a function
// through its body or its `;`.
function captureDeclaration(p: borrow mut Parser) -> [Token] {
    var tokens: [Token] = []
    var braces = 0
    var parens = 0
    while peekKind(p) != .End && p.error == "" {
        let t = consume(p)
        tokens.append(t)
        if t.kind == .LParen { parens = parens + 1 }
        if t.kind == .RParen { parens = parens - 1 }
        if t.kind == .LBrace { braces = braces + 1 }
        if t.kind == .RBrace {
            braces = braces - 1
            if braces == 0 && parens == 0 {
                if peekKind(p) == .Semicolon { tokens.append(consume(p)) }
                return tokens
            }
        }
        if t.kind == .Semicolon && braces == 0 && parens == 0 { return tokens }
    }
    return tokens
}
// The name a function template declares: the identifier before its first
// `(`, with `operator` and its symbol joined.
function templateFunctionName(tokens: [Token]) -> String {
    for i in 1..tokens.count {
        if tokens[i].kind == .LParen {
            if tokens[i - 1].kind == .Ident { return tokens[i - 1].text }
            return ""
        }
        if tokens[i].kind == .Ident && tokens[i].text == "operator" { return "" }
    }
    return ""
}
// The name a member operator template declares: `operator` joined with its
// symbol, as `operator()` or `operator=`.
function templateOperatorName(tokens: [Token]) -> String {
    for i in 0..tokens.count {
        if tokens[i].kind == .Ident && tokens[i].text == "operator" {
            if i + 2 < tokens.count && tokens[i + 1].kind == .LParen && tokens[i + 2].kind == .RParen { return "operator()" }
            var pieces: [String] = ["operator"]
            var j = i + 1
            while j < tokens.count && tokens[j].kind != .LParen {
                pieces.append(tokens[j].text)
                j = j + 1
            }
            return joinText(pieces)
        }
    }
    return ""
}
function closesAngle(p: borrow Parser) -> Bool {
    return p.pendingGt || peekKind(p) == .Gt || peekKind(p) == .Shr
}
// Consumes the `>` closing an argument list, splitting a `>>`.
function expectCloseAngle(p: borrow mut Parser) {
    if p.pendingGt {
        p.pendingGt = false
        return
    }
    if peekKind(p) == .Shr {
        consume(p)
        p.pendingGt = true
        return
    }
    expect(p, .Gt)
}
// The class template a written name names here, or -1.
function classTemplateIndex(p: borrow Parser, name: String) -> Int {
    let found = resolveIn(p, name, entityTypeKinds())
    if found == "" || !hasKind(entityKinds(p.tree, found), .ClassTemplate) { return -1 }
    return templateNamed(p.tree, found)
}
function spelledTemplateIndex(p: borrow Parser, spelled: String, name: String) -> Int {
    return classTemplateIndex(p, spelled)
}
// The class template with qualified name `name`, the latest declared.
function templateNamed(tree: CppTree, name: String) -> Int {
    var i = tree.templates.count
    while i > 0 {
        i = i - 1
        if tree.templates[i].isClass && tree.templates[i].name == name { return i }
    }
    return -1
}
// A spelling usable in an identifier for one template argument.
function mangleArgument(argument: String) -> String {
    var pieces: [String] = []
    for i in 0..utf8Count(argument) {
        let c = utf8Byte(argument, i)
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
            pieces.append(utf8Slice(argument, i, i + 1))
        } else if c == 42 {
            pieces.append("p")
        } else if c == 91 {
            pieces.append("a")
        } else if c == 37 || c == 32 || c == 93 {
            pieces.append("")
        } else {
            pieces.append("_")
        }
    }
    return joinText(pieces)
}
// An instance is a member of the template's scope: `a::vector__i32`.
function instanceName(name: String, arguments: [String]) -> String {
    var pieces: [String] = [name]
    for argument in arguments {
        pieces.append("__")
        pieces.append(mangleArgument(argument))
    }
    return joinText(pieces)
}
// `<args>` after a template name: type arguments as karc type spellings,
// value arguments as decimal text; omitted trailing arguments take their
// defaults.
function parseTemplateArguments(p: borrow mut Parser, index: Int) -> [String] {
    let template = p.tree.templates[index]
    expect(p, .Lt)
    var arguments: [String] = []
    while !closesAngle(p) && peekKind(p) != .End && p.error == "" {
        let position = arguments.count
        var valuePosition = position
        if template.pack >= 0 && position > template.pack { valuePosition = template.pack }
        if valuePosition < template.valueParams.count && template.valueParams[valuePosition] {
            let value = expression(p, 9)
            arguments.append(decimalText(constantExpression(p, value)))
        } else {
            var argument = parseFunctionTypeArgument(p, parseTypeToken(p))
            if peekKind(p) == .LBracket {
                // `T[]` or `T[N]`: an array type.
                consume(p)
                var bound = 0
                if peekKind(p) == .Number { bound = consume(p).number }
                expect(p, .RBracket)
                argument = joinText(["[", decimalText(bound), " x ", argument, "]"])
            }
            arguments.append(argument)
        }
        if peekKind(p) == .Comma { consume(p) }
    }
    expectCloseAngle(p)
    while arguments.count < template.params.count && p.error == "" {
        let fallback = template.defaults[arguments.count]
        if fallback.count == 0 { break }
        let substituted = substituteTokens(p, template, arguments, fallback)
        if template.valueParams[arguments.count] {
            if substituted[0].kind == .Number {
                arguments.append(decimalText(substituted[0].number))
            } else if substituted[0].kind == .Minus && substituted.count > 1 && substituted[1].kind == .Number {
                arguments.append(decimalText(0 - substituted[1].number))
            } else {
                arguments.append(substituted[0].text)
            }
        } else {
            let outerScope = p.scope
            p.scope = templateScope(template.name)
            arguments.append(parseTypeFromTokens(p, substituted))
            p.scope = outerScope
        }
    }
    return arguments
}
function parseTypeFromTokens(p: borrow mut Parser, tokens: [Token]) -> String {
    var stream = tokens
    stream.append(Token { space = false, spelling = "", kind = .End, text = "", number = 0, start = 0, end = 0, line = false })
    var q = subParser(p, stream)
    let result = parseTypeToken(q)
    p.tree = q.tree
    return result
}
// The template's tokens with each parameter replaced: a type by a typedef
// naming the argument, a value by its number. The template's own name, used
// alone inside a class template, names the instance.
function substituteTokens(p: borrow mut Parser, template: CppTemplate, arguments: [String], tokens: [Token]) -> [Token] {
    var aliases: [String] = []
    for i in 0..arguments.count {
        if template.valueParams[i] {
            aliases.append("")
        } else {
            let alias = joinText(["__karc_targ_", decimalText(p.tree.typedefs.count)])
            addTypedef(p.tree, alias, arguments[i])
            aliases.append(alias)
        }
    }
    let instance = instanceName(template.name, arguments)
    let bare = unqualifiedName(template.name)
    var result: [Token] = []
    for i in 0..tokens.count {
        let t = tokens[i]
        var replaced = false
        if t.kind == .Ident {
            for j in 0..arguments.count {
                if !replaced && j < template.params.count && t.text == template.params[j] {
                    replaced = true
                    if template.valueParams[j] {
                        result.append(Token { space = false, spelling = "", kind = .Number, text = arguments[j], number = numberValue(arguments[j]), start = t.start, end = t.end, line = t.line })
                    } else {
                        result.append(Token { space = false, spelling = "", kind = .Ident, text = aliases[j], number = 0, start = t.start, end = t.end, line = t.line })
                    }
                }
            }
            let followedByArguments = i + 1 < tokens.count && tokens[i + 1].kind == .Lt
            if !replaced && template.isClass && t.text == bare && !followedByArguments {
                replaced = true
                result.append(Token { space = false, spelling = "", kind = .Ident, text = instance, number = 0, start = t.start, end = t.end, line = t.line })
            }
        }
        if !replaced { result.append(t) }
    }
    return result
}
function numberValue(text: String) -> Int {
    var value = 0
    var negative = false
    for i in 0..utf8Count(text) {
        let c = utf8Byte(text, i)
        if c == 45 { negative = true }
        if c >= 48 && c <= 57 { value = value * 10 + c - 48 }
    }
    if negative { return 0 - value }
    return value
}
// Parses `tokens` as top-level declarations with a parser of their own over
// the same tree, which then replaces the caller's.
function parseSpliced(p: borrow mut Parser, tokens: [Token]) {
    var stream = tokens
    stream.append(Token { space = false, spelling = "", kind = .End, text = "", number = 0, start = 0, end = 0, line = false })
    // The functions the enclosing parse deferred stay deferred: they belong
    // after its own function, not after this instance.
    var waiting: [CppFunction] = []
    for fn in p.deferredFunctions { waiting.append(fn) }
    var q = subParser(p, stream)
    q.deferredFunctions = []
    while peekKind(q) != .End && q.error == "" {
        parseTopLevel(q)
        flushDeferred(q)
    }
    p.tree = q.tree
    p.deferredFunctions = waiting
    if q.error != "" && p.error == "" {
        p.error = q.error
        p.errorOffset = q.errorOffset
        p.expected = q.expected
    }
}
// The instance of class template `index` for `arguments`, parsed on first
// use. A use inside its own definition names it without parsing it again.
function instantiateClass(p: borrow mut Parser, index: Int, arguments: [String]) -> String {
    let template = p.tree.templates[index]
    let instance = instanceName(template.name, arguments)
    if structNamed(p.tree, instance) >= 0 { return instance }
    for pending in p.instantiating {
        if pending == instance { return instance }
    }
    if p.error != "" { return instance }
    if template.tokens[0].text == "using" { return nominalName(aliasTemplateType(p, index, arguments)) }
    p.instantiating.append(instance)
    p.tree.instances.append(CppInstance { name = instance, template = template.name, arguments = arguments })
    var tokens = specializedTokens(p, template.name, arguments, instance)
    if tokens.count == 0 { tokens = instantiateTokens(p, template, arguments, template.tokens) }
    let outerScope = p.scope
    p.scope = templateScope(template.name)
    parseSpliced(p, tokens)
    p.scope = outerScope
    var rest: [String] = []
    for i in 0..(p.instantiating.count - 1) { rest.append(p.instantiating[i]) }
    p.instantiating = rest
    for i in 0..p.tree.structs.count {
        let s = p.tree.structs[i]
        if s.name == instance {
            p.tree.structs[i] = CppStruct { name = s.name, nameSpan = s.nameSpan, fields = s.fields, internal = s.internal, instance = true, span = s.span }
        }
    }
    return instance
}
// The type an alias template names for `arguments`: `using X = Y<T>;`.
function aliasTemplateType(p: borrow mut Parser, index: Int, arguments: [String]) -> String {
    let template = p.tree.templates[index]
    let substituted = instantiateTokens(p, template, arguments, template.tokens)
    var aliased: [Token] = []
    var after = false
    for t in substituted {
        let skipped = t.kind == .Semicolon || (t.kind == .Ident && t.text == "typename")
        if after && !skipped { aliased.append(t) }
        if t.kind == .Assign { after = true }
    }
    let outerScope = p.scope
    p.scope = templateScope(template.name)
    let aliasedType = parseTypeFromTokens(p, aliased)
    p.scope = outerScope
    return aliasedType
}
function functionTemplateByName(tree: CppTree, name: String) -> Bool {
    for t in tree.templates {
        if !t.isClass && t.owner != "@variable" && (t.name == name || qualifiedNamesMatch(t.name, name)) { return true }
    }
    return false
}
// `<T, U>` after a function template's name: types only.
function parseExplicitArguments(p: borrow mut Parser) -> [String] {
    expect(p, .Lt)
    var arguments: [String] = []
    while !closesAngle(p) && peekKind(p) != .End && p.error == "" {
        var argument = parseTypeToken(p)
        if peekKind(p) == .LBracket {
            // `T[]` or `T[N]`, as in make_unique<int[]>.
            consume(p)
            var bound = 0
            if peekKind(p) == .Number { bound = consume(p).number }
            expect(p, .RBracket)
            argument = joinText(["[", decimalText(bound), " x ", argument, "]"])
        }
        arguments.append(argument)
        if peekKind(p) == .Comma { consume(p) }
    }
    expectCloseAngle(p)
    return arguments
}
// `R(A, B)` as a template argument: the function-pointer type `fn<R|A,B>`.
function parseFunctionTypeArgument(p: borrow mut Parser, result: String) -> String {
    // After a split `>>` the list is closed: a `(` begins a call.
    if p.pendingGt || peekKind(p) != .LParen { return result }
    consume(p)
    var parameters: [String] = []
    if peekKind(p) == .KwVoid && peek2Kind(p) == .RParen { consume(p) }
    while peekKind(p) != .RParen && peekKind(p) != .End && p.error == "" {
        if parameters.count > 0 { parameters.append(",") }
        let parameter = parseParameter(p)
        if parameter.reference {
            parameters.append(joinText(["&", parameter.declType]))
        } else {
            parameters.append(parameter.declType)
        }
        if peekKind(p) == .Comma { consume(p) }
    }
    expect(p, .RParen)
    return joinText(["fn<", result, "|", joinText(parameters), ">"])
}
